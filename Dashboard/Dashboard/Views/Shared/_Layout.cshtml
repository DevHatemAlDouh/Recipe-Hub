<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Dashboard.styles.css" asp-append-version="true" />
</head>
<body>
    <button id="theme-toggle" class="btn btn-dark" style="position: fixed; bottom: 20px; left: 20px; z-index: 100000;">
        Toggle Dark Mode
    </button>

    @if (User.Identity.IsAuthenticated)
    {

        <div class="sidebar">
            <h1>Recipehub</h1>
            <a class="@(ViewContext.RouteData.Values["controller"].ToString() == "Home" ? "active-sidebar" :"")" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
            <a class="@(ViewContext.RouteData.Values["controller"].ToString() == "Users" ? "active-sidebar" :"")" asp-area="" asp-controller="Users" asp-action="Index">Users</a>
            <a class="@(ViewContext.RouteData.Values["controller"].ToString() == "Permissions" ? "active-sidebar" :"")" asp-area="" asp-controller="Permissions" asp-action="Index">Permissions</a>
            <a class="@(ViewContext.RouteData.Values["controller"].ToString() == "Ingredients" ? "active-sidebar" :"")" asp-area="" asp-controller="Ingredients" asp-action="Index">Ingredients</a>
            <a class="@(ViewContext.RouteData.Values["controller"].ToString() == "Categories" ? "active-sidebar" :"")" asp-area="" asp-controller="Categories" asp-action="Index">Categories</a>
            <a class="@(ViewContext.RouteData.Values["controller"].ToString() == "Recipes" ? "active-sidebar" :"")" asp-area="" asp-controller="Recipes" asp-action="Index">Recipes</a>
        </div>
        <div class="position-absolute User-Info">
            <a asp-area="" asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm">Logout</a>
            @User.Identity.Name
        </div>
        <div class="content">
            <div class="container">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        </div>

        
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <script>
        const toggleButton = document.getElementById('theme-toggle');
        const currentTheme = localStorage.getItem('theme');

        if (currentTheme) {
            document.documentElement.setAttribute('data-theme', currentTheme);
        }

        toggleButton.addEventListener('click', () => {
            let theme = document.documentElement.getAttribute('data-theme');
            theme = (theme === 'dark') ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('theme', theme);
        });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>