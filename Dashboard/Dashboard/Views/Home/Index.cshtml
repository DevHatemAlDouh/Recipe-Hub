

@{
    ViewBag.Title = "Home";
}

<div class="container-fluid d-flex ">
    <div class="card m-2 flex-fill">
        <div class="card-body fw-bold fs-5">Total Recipes</div>
        <div class="card-body">5</div>
    </div>
    <div class="card m-2 flex-fill">
        <div class="card-body fw-bold fs-5">Total Views</div>
        <div class="card-body">55</div>
    </div>
    <div class="card m-2 flex-fill">
        <div class="card-body fw-bold fs-5">Total Likes</div>
        <div class="card-body">555</div>
    </div>
    <div class="card m-2 flex-fill">
        <div class="card-body fw-bold fs-5">Total Users</div>
        <div class="card-body">5555</div>
    </div>
</div>


<div class="container-fluid d-flex me-3">
    <div class="container-fluid flex-column flex-fill col-12">
        <div class="card m-2">
            <div class="card-body fw-bold fs-4">Interactors</div>
            <div class="d-flex justify-content-between">
                <div class="skill position-relative m-5">
                    <div class="outer position-absolute rounded-circle" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">
                    </div>
                    <div class="mid position-absolute rounded-circle" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100">
                    </div>
                    <div class="internal position-absolute rounded-circle" role="progressbar" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>
                <div class="card m-5 ">
                    <div class="card-body position-relative">
                        <div class="user-info"></div>
                        <span class="mx-3 fw-bold fs-6">Users</span>
                    </div>
                    <div class="card-body position-relative">
                        <div class="outer-info"></div>
                        <span class="mx-3 fw-bold fs-6">likes on Recipe</span>
                    </div>
                    <div class="card-body position-relative">
                        <div class="mid-info"></div>
                        <span class="mx-3 fw-bold fs-6">Comments on Recipe</span>
                    </div>
                    <div class="card-body position-relative">
                        <div class="internal-info"></div>
                        <span class="mx-3 fw-bold fs-6">Likes on Comment</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container-fluid flex-column flex-fill col-7">
        <div class="m-3 fw-bold fs-5">Most Popular Recipe</div>
        <div class="card m-2">
            <div class="d-flex card-body">
                <img class="populer rounded-circle" src=" ./as/group 1.png" alt="Alternate Text" />
                <div class="flex-column">
                    <div class="px-4">
                        <div class="fw-bold fs-5">ss</div>
                        <div class="card-subtitle fw-light">s</div>
                    </div>
                    <div class="d-flex">
                        <div class="px-3">50K likes</div>
                        <div class="px-3">250K views</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card m-2">
            <div class="d-flex card-body">
                <img class="populer rounded-circle" src=" ./as/group 1.png" alt="Alternate Text" />
                <div class="flex-column">
                    <div class="px-4">
                        <div class="fw-bold fs-5">ss</div>
                        <div class="card-subtitle fw-light">s</div>
                    </div>
                    <div class="d-flex">
                        <div class="px-3">50K likes</div>
                        <div class="px-3">250K views</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card m-2">
            <div class="d-flex card-body">
                <img class="populer rounded-circle" src=" ./as/group 1.png" alt="Alternate Text" />
                <div class="flex-column">
                    <div class="px-4">
                        <div class="fw-bold fs-5">ss</div>
                        <div class="card-subtitle fw-light">s</div>
                    </div>
                    <div class="d-flex">
                        <div class="px-3">50K likes</div>
                        <div class="px-3">250K views</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const progressbarouter = document.querySelector(".outer");
    const progressbarmid = document.querySelector(".mid");
    const progressbarinternal = document.querySelector(".internal");
    progressbarouter.style.setProperty("--progress",progressbarouter.getAttribute("aria-valuenow")+"%");
    progressbarmid.style.setProperty("--progress",progressbarmid.getAttribute("aria-valuenow")+"%");
    progressbarinternal.style.setProperty("--progress",progressbarinternal.getAttribute("aria-valuenow")+"%");
</script>