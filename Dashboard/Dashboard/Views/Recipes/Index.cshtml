@{
}
@using System.Data
@model DataTable

@{
    ViewBag.Title = "Recipes";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Recipes</h2>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">Create New Recipe</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Actions</th>
                <th>Suggestions</th>
                <th>Comments</th>
            </tr>
        </thead>
        <tbody>
            @foreach (DataRow row in Model.Rows)
            {
                <tr>
                    <td>@row["Id"]</td>
                    <td>@row["Title"]</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@row["Id"]" class="btn btn-info btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@row["Id"]" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@row["Id"]" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this permission?');">Delete</a>
                    </td>
                    <td>
                        <a asp-action="Suggestions" asp-route-id="@row["Id"]" class="btn btn-info btn-sm">Suggestions</a>
                    </td>
                    <td>
                        <a asp-action="Comments" asp-route-id="@row["Id"]" class="btn btn-info btn-sm">Comments</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>