@model Recipe_details

@{
    ViewBag.Title = "Create Recipe";
}

<div class="container mt-5">
    <div class="card">
        <div class="card-header">
            <h4>Create Recipe</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <div class="form-group">
                    <label asp-for="Recipe.title">Title</label>
                    <input type="text" class="form-control" asp-for="Recipe.title" required />
                </div>
                <div class="form-group">
                    <label asp-for="Recipe.description">Description</label>
                    <input type="text" class="form-control" asp-for="Recipe.description" />
                </div>
                <div class="form-group">
                    <label asp-for="Recipe.persons">persons</label>
                    <input type="number" class="form-control" asp-for="Recipe.persons" />
                </div>
                <div class="form-group">
                    <label asp-for="Recipe.backgroundImageBase64">Background Image</label>
                    <input type="file" accept="image/*" class="form-control recipe-image" asp-for="Recipe.backgroundImageBase64" />
                    <img class="img-preview" src="#" alt="Recipe Image Preview" style="display:none; max-width:100%; margin-top:10px;" />
                </div>

                <br />

                <div id="categories-container">
                    <div class="card">
                        <div class="card-header">
                            <h4>Add Categories</h4>
                        </div>
                        <div class="card-body">
                            <input type="button" id="add-category" class="btn btn-secondary" value="Add Category" />
                        </div>
                    </div>
                </div>

                <br />

                <div id="steps-container">
                    <div class="card">
                        <div class="card-header">
                            <h4>Add Steps</h4>
                        </div>
                        <div class="card-body">
                            <input type="button" id="add-step" class="btn btn-secondary" value="Add Step" />
                        </div>
                    </div>
                </div>

                <br />

                <div id="ingredients-container">
                    <div class="card">
                        <div class="card-header">
                            <h4>Add Ingredients</h4>
                        </div>
                        <div class="card-body">
                            <input type="button" id="add-ingredient" class="btn btn-secondary" value="Add Ingredient" />
                        </div>
                    </div>
                </div>

                <br />

                <button type="submit" class="btn btn-primary">Create</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            let stepCount = 0;
            let ingredientCount = 0;
            let categoryCount = 0;

            // Preview for the recipe background image
            $('.recipe-image').change(function (event) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    $('.img-preview').attr('src', e.target.result).show();
                }
                reader.readAsDataURL(event.target.files[0]);
            });

            $('#add-step').click(function () {
                const newStep = `
                    <div class="step-form">
                        <div class="form-group">
                            <label>Step Number</label>
                            <input type="number" class="form-control" name="steps[${stepCount}].StepNumber" value="${stepCount + 1}" readonly />
                        </div>
                        <div class="form-group">
                            <label>Description</label>
                            <input type="text" class="form-control" name="steps[${stepCount}].description" />
                        </div>
                        <div class="form-group">
                            <label>Background Image</label>
                            <input type="file" accept="image/*" class="form-control step-image" name="steps[${stepCount}].backgroundImageBase64" />
                            <img class="img-preview" src="#" alt="Image Preview" style="display:none; max-width:100%; margin-top:10px;" />
                        </div>
                        <br />
                        <button type="button" class="btn btn-danger remove-step">Remove Step</button>
                    </div>`;
                $('#steps-container').append(newStep);
                stepCount++;
            });

            $('#add-ingredient').click(function () {
                const newIngredient = `
                    <div class="ingredient-form">
                        <div class="form-group">
                            <label>Select Ingredient</label>
                            <select name="recipeIngredients[${ingredientCount}].IngredientID" class="form-control" required>
                                <option value="">-- Select Ingredient --</option>
        @foreach (var ingredient in Model.ingredients)
        {
                                        <option value="@ingredient.Id">@ingredient.Name</option>
        }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Quantity</label>
                            <input type="number" class="form-control" name="recipeIngredients[${ingredientCount}].quantity" />
                        </div>
                        <div class="form-group">
                            <label>Unit</label>
                            <input type="text" class="form-control" name="recipeIngredients[${ingredientCount}].unit" />
                        </div>
                        <br />
                        <button type="button" class="btn btn-danger remove-ingredient">Remove Ingredient</button>
                    </div>`;
                $('#ingredients-container').append(newIngredient);
                ingredientCount++;
            });

            $('#add-category').click(function () {
                const newCategory = `
                    <div class="category-form">
                        <div class="form-group">
                            <label>Select Category</label>
                            <select name="recipeCategories[${categoryCount}].CategoryID" class="form-control" required>
                                <option value="">-- Select Category --</option>
        @foreach (var category in Model.categories)
        {
                                        <option value="@category.Id">@category.Name</option>
        }
                            </select>
                        </div>
                        <br />
                        <button type="button" class="btn btn-danger remove-category">Remove Category</button>
                    </div>`;
                $('#categories-container').append(newCategory);
                categoryCount++;
            });

            // Image preview for steps
            $(document).on('change', '.step-image', function (event) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    $(event.target).siblings('.img-preview').attr('src', e.target.result).show();
                }
                reader.readAsDataURL(event.target.files[0]);
            });

            // Remove step functionality
            $(document).on('click', '.remove-step', function () {
                $(this).closest('.step-form').remove();
                updateStepNumbers();
            });

            // Remove ingredient functionality
            $(document).on('click', '.remove-ingredient', function () {
                $(this).closest('.ingredient-form').remove();
                updateIngredientNumbers();
            });

            // Remove category functionality
            $(document).on('click', '.remove-category', function () {
                $(this).closest('.category-form').remove();
                updateCategoryNumbers();
            });

            function updateStepNumbers() {
                $('#steps-container .step-form').each(function (index) {
                    $(this).find('input[name^="steps"]').each(function () {
                        const name = $(this).attr('name').replace(/\[\d+\]/, `[${index}]`);
                        $(this).attr('name', name);
                    });
                    $(this).find('input[type="number"]').val(index + 1); // Update Step Number display
                });
                stepCount = $('#steps-container .step-form').length; // Update stepCount
            }

            function updateIngredientNumbers() {
                $('#ingredients-container .ingredient-form').each(function (index) {
                    $(this).find('select[name^="recipeIngredients"]').each(function () {
                        const name = $(this).attr('name').replace(/\[\d+\]/, `[${index}]`);
                        $(this).attr('name', name);
                    });
                });
                ingredientCount = $('#ingredients-container .ingredient-form').length; // Update ingredientCount
            }

            function updateCategoryNumbers() {
                $('#categories-container .category-form').each(function (index) {
                    $(this).find('select[name^="recipeCategories"]').each(function () {
                        const name = $(this).attr('name').replace(/\[\d+\]/, `[${index}]`);
                        $(this).attr('name', name);
                    });
                });
                categoryCount = $('#categories-container .category-form').length; // Update categoryCount
            }
        });
    </script>
}