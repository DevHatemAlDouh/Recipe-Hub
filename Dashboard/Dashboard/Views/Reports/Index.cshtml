@using System.Data
@model DataTable

@{
    ViewBag.Title = "Reports";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Reports</h2>
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Id</th>
                <th>description</th>
                <th>resolved</th>
            </tr>
        </thead>
        <tbody>
            @foreach (DataRow row in Model.Rows)
            {
                <tr>
                    <td>@row["Id"]</td>
                    <td>@row["description"]</td>
                    <td>
                        @{
                            if (@row["resolved"].ToString() == "true")
                            {
                                <div class="btn btn-danger btn-sm">solved</div>
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@row["Id"]" class="btn btn-info btn-sm">Details</a>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>