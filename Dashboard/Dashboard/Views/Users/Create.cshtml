@model User

@{
    ViewBag.Title = "Create User";
}

<div class="container mt-5">

    <div class="card">
        <div class="card-header">
            <h4>Create User</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <div class="form-group">
                    <label asp-for="UserName">Username</label>
                    <input type="text" class="form-control" asp-for="UserName" required />
                </div>
                <div class="form-group">
                    <label asp-for="PhoneNumber">Phone Number</label>
                    <input type="text" class="form-control" asp-for="PhoneNumber" />
                </div>
                <div class="form-group">
                    <label asp-for="CountryCode">Country Code</label>
                    <input type="text" class="form-control" asp-for="CountryCode" />
                </div>
                <div class="form-group">
                    <label asp-for="Email">Email</label>
                    <input type="email" class="form-control" asp-for="Email" required />
                </div>
                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <input type="password" class="form-control" asp-for="Password" required />
                </div>
                <div class="form-group">
                    <label asp-for="UserImageBase64">User Image</label>
                    <input type="file" accept="image/*" class="form-control" asp-for="UserImageBase64" name="UserImageBase64" />
                </div>

                <br />

                <button type="submit" class="btn btn-primary">Create</button>
            </form>

            <div class="text-center mt-3">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>