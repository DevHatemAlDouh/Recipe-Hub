@model User

@{
    ViewBag.Title = "Edit User";
}

<div class="container mt-5">
    <div class="card">
        <div class="card-header">
            <h4>Edit User</h4>
        </div>
        <div class="card-body">
            <form asp-action="Update" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="form-group">
                    <label asp-for="UserName"></label>
                    <input type="text" class="form-control" asp-for="UserName" required />
                </div>

                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input type="email" class="form-control" asp-for="Email" required />
                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber"></label>
                    <input type="text" class="form-control" asp-for="PhoneNumber" />
                </div>

                <div class="form-group">
                    <label asp-for="CountryCode"></label>
                    <input type="text" class="form-control" asp-for="CountryCode" />
                </div>

                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input type="password" class="form-control" asp-for="Password" />
                </div>

                <div class="form-group">
                    <label asp-for="UserImage">User Image</label>
                    <input type="file" class="form-control" asp-for="UserImage" name="UserImage" />
                </div>

                <br />
                <button type="submit" class="btn btn-primary">Save</button>
            </form>

            <div class="text-center mt-3">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>