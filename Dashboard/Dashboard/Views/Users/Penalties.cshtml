@using System.Data

@model User_All_Penalties

@{
    ViewBag.Title = $"{Model.user.UserName} Permissions";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">@Model.user.UserName Permissions</h2>

    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Id</th>
                <th>Permissions</th>
                <th>Actions</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var PER in Model.user_Penalties)
            {
                <tr>
                    <td>@PER.Id</td>
                    @foreach (var row in Model.penalties.Where(p => p.Id == PER.PenaltyID))
                    {
                        @if (row.Id == PER.PenaltyID)
                        {
                            <td>@row.Description</td>
                        }
                    }
                    <td>
                        <a asp-action="RevokePenalty" asp-route-id="@PER.Id" class="btn btn-danger btn-sm">Revoke</a>
                    </td>
                    @if (@PER.IsActive)
                    {
                        <td><div class="btn btn-info btn-sm">Active</div></td>
                    }
                    else
                    {
                        <td><div class="btn btn-danger btn-sm">NotActive</div></td>
                    }
                </tr>
            }

        </tbody>
    </table>
</div>
