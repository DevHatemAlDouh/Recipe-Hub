@using System.Data

@model User_All_Permissions

@{
    ViewBag.Title = $"{Model.user.UserName} Permissions";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">@Model.user.UserName Permissions</h2>

    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Id</th>
                <th>Permissions</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.permission)
            {
                <tr> 
                     <td>@row.Id</td> 
                     <td>@row.Title</td>
                     <td>
                        <a asp-action="Revoke" asp-route-id="@row.Id" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this user?');">Revoke</a>
                    </td> 
                 </tr> 
             }
        </tbody>
    </table>

    <div class="text-center">
        <a asp-action="Create" class="btn btn-primary">Create New User</a>
    </div>
</div>
