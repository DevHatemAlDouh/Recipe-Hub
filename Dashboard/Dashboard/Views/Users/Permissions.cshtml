@using System.Data

@model User_All_Permissions

@{
    ViewBag.Title = $"{Model.user.UserName} Permissions";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">@Model.user.UserName Permissions</h2>

    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Id</th>
                <th>Permissions</th>
                <th>Actions</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var PER in Model.user_permission)
            {
                <tr>
                    <td>@PER.Id</td>
                    @foreach (var row in Model.permission.Where(p => p.Id == PER.PermissionID))
                    {
                        @if (row.Id == PER.PermissionID)
                        {
                            <td>@row.Title</td>
                        }
                    }
                    <td>
                        <a asp-action="RevokePermission" asp-route-id="@PER.Id" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this user?');">Revoke</a>
                    </td>
                    @if (@PER.IsActive)
                    {
                        <td><div class="btn btn-info btn-sm">Active</div></td>
                    }else {
                        <td><div class="btn btn-danger btn-sm">NotActive</div></td>
                    }
                </tr>
            }
            
        </tbody>
    </table>
    <div class="text-center mt-3">
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
