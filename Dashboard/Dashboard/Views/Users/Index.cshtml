@using System.Data

@model DataTable

@{
    ViewBag.Title = "Users";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Users</h2>

    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Id</th>
                <th>Username</th>
                <th>Actions</th>
                <th>Permissions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (DataRow row in Model.Rows)
            {
                <tr>
                    <td>@row["Id"]</td>
                    <td>@row["Username"]</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@row["Id"]" class="btn btn-info btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@row["Id"]" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@row["Id"]" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this user?');">Delete</a>
                    </td>
                    <td>
                        <a asp-action="Permissions" asp-route-id="@row["Id"]" class="btn btn-info btn-sm">Permissions</a>
                        <a asp-action="Grant" asp-route-id="@row["Id"]" class="btn btn-warning btn-sm">Grant</a>
                        @* <a asp-action="Revoke" asp-route-id="@row["Id"]" class="btn btn-danger btn-sm">Revoke</a> *@
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-center">
        <a asp-action="Create" class="btn btn-primary">Create New User</a>
    </div>
</div>
