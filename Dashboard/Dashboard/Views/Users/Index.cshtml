@using System.Data

@model DataTable

<h2>Users</h2>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Username</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (DataRow row in Model.Rows)
        {
            <tr>
                <td>@row["Id"]</td>
                <td>@row["Username"]</td>
                <td>
                    <a asp-action="Details" asp-route-id="@row["Id"]">Details</a> |
                    <a asp-action="Edit" asp-route-id="@row["Id"]">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@row["Id"]">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Create New User</a>

