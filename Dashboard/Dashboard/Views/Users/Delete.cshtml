@using System.Data
@model DataTable

<h2>Delete User</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>User</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.GetType().GetProperty("Id").GetValue(Model, null)</dd>
        <dt class="col-sm-2">Username</dt>
        <dd class="col-sm-10">@Model.GetType().GetProperty("Username").GetValue(Model, null)</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.GetType().GetProperty("Email").GetValue(Model, null)</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="@Model.GetType().GetProperty("Id").GetValue(Model, null)" />
    <button type="submit" class="btn btn-danger">Delete</button> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
