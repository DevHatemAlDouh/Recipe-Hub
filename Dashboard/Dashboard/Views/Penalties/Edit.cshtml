@model PenaltyInfo

@{
    ViewBag.Title = "Edit Penalty";
}

<div class="container mt-5">
    <div class="card">
        <div class="card-header">
            <h4>Edit Penalty</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="penalty.Id" />
                <div class="form-group">
                    <label asp-for="penalty.TimeOut">TimeOut</label>
                    <input type="datetime-local" class="form-control" asp-for="penalty.TimeOut" required />
                </div>

                <div class="form-group">
                    <label asp-for="penalty.Description">Description</label>
                    <input type="text" class="form-control" asp-for="penalty.Description" required />
                </div>

                <br />

                <div id="terms-container">
                    <div class="card">
                        <div class="card-header">
                            <h4>Terms</h4>
                        </div>
                        <div class="card-body">
                            @{
                                int termIndex = 0;
                                foreach (var term in Model.Lterms)
                                {
                                    <div class="term-form">
                                        <div class="form-group">
                                            <label>Select Permission</label>
                                            <select name="terms[@termIndex].permissionid" class="form-control" required>
                                                <option value="">-- Select Permission --</option>
                                                @foreach (var permission in Model.permissions)
                                                {
                                                    <option value="@permission.Id">@permission.Title</option>
                                                }
                                            </select>
                                            <input type="hidden" name="terms[@termIndex].Id" value="@term.Id" />
                                        </div>
                                        <button type="button" class="btn btn-danger remove-term">Remove Term</button>
                                        <br />
                                    </div>
                                    termIndex++; // Increment after using
                                }
                            }
                            <input type="button" id="add-term" class="btn btn-secondary" value="Add Term" />
                        </div>
                    </div>
                </div>

                <br />

                <button type="submit" class="btn btn-primary">Save Changes</button>
            </form>

            <div class="text-center mt-3">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var termCount = @Model.Lterms.Count(); // Initialize termCount from model

            $('#add-term').click(function () {
                const newTerm = `
                    <div class="term-form">
                        <div class="form-group">
                            <label>Select Permission</label>
                            <select name="terms[${termCount}].permissionid" class="form-control" required>
                                <option value="">-- Select Permission --</option>
                                @foreach (var permission in Model.permissions)
                                {
                                    <option value="@permission.Id">@permission.Title</option>
                                }
                            </select>
                        </div>
                        <button type="button" class="btn btn-danger remove-term">Remove Term</button>
                        <br />
                    </div>`;
                $('#terms-container').append(newTerm);
                termCount++;
            });

            // Remove term functionality
            $(document).on('click', '.remove-term', function () {
                $(this).closest('.term-form').remove();
            });
        });
    </script>
}